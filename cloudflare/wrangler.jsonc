{
  "name": "rust-messenger",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "ChatHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatHub"] }],
  "observability": { "enabled": true }
}
